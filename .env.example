# Kaggle API credentials
# Get yours from: https://www.kaggle.com/settings/account → Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# MotherDuck token (optional, for cloud DuckDB sync)
# Get yours from: https://app.motherduck.com/settings
MOTHERDUCK_TOKEN=

# Slack webhook (optional, for Elementary alerts)
SLACK_WEBHOOK_URL=
